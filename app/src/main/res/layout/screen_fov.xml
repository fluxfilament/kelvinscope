<?xml version="1.0" encoding="utf-8"?>
<!--
    Field of view is a fixed property of the optics, so it belongs on a screen of its
    own where it can be set against a real subject once and left alone. The comparison
    is live rather than a frozen frame: lining two lenses up means moving the camera
    and watching the edges meet.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenFov"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/fovHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/fovBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Ff.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/fov_title" />

        <TextView
            android:id="@+id/fovReset"
            style="@style/Ff.Mono"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/fov_reset"
            android:textAllCaps="true"
            android:textColor="@color/ff_accent2"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">

        <com.fluxfilament.thermalcam.SplitPreviewView
            android:id="@+id/splitPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_well_outline"
            android:contentDescription="@string/fov_split_description" />

        <ImageButton
            android:id="@+id/splitTurn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_tool"
            android:contentDescription="@string/fov_turn_divider"
            android:src="@drawable/ic_split_turn" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp">

        <!-- Columns as wide as their label, at least the thumbnail: "VIS 1440×1080"
             is wider than 72 dp and used to wrap onto a second line. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="72dp"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_well_outline">

                <ImageView
                    android:id="@+id/thumbThermal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <TextView
                android:id="@+id/fovResThermal"
                style="@style/Ff.Mono"
                android:maxLines="1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.04"
                android:text="@string/fov_res_thermal_none"
                android:textColor="@color/ff_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:minWidth="72dp"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_well_outline">

                <ImageView
                    android:id="@+id/thumbVisible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

                <!-- Which part of the wider visible frame the current setting keeps. -->
                <View
                    android:id="@+id/cropRect"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_crop" />
            </FrameLayout>

            <TextView
                android:id="@+id/fovResVisible"
                style="@style/Ff.Mono"
                android:maxLines="1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.04"
                android:text="@string/fov_res_visible_none"
                android:textColor="@color/ff_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <TextView
                style="@style/Ff.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fov_value"
                android:textColor="@color/ff_muted" />

            <TextView
                android:id="@+id/fovValue"
                style="@style/Ff.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="29sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Ff.RowSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jetbrains_mono"
                android:text="@string/fov_default" />
        </LinearLayout>
    </LinearLayout>

    <SeekBar
        android:id="@+id/fovSeek"
        style="@style/Ff.Seek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="6dp"
        android:contentDescription="@string/fov_description"
        android:max="120"
        android:min="40" />

    <!-- The same Align as on the main screen, kept in step with it. Setting a camera
         up for the first time means finding both at once, against the same edge. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <TextView
            android:id="@+id/fovAlignLabel"
            style="@style/Ff.Mono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="100dp"
            android:maxLines="1"
            android:letterSpacing="0.06"
            android:textColor="@color/ff_muted"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/fovAlignSeek"
            style="@style/Ff.Seek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:contentDescription="@string/align_description"
            android:max="200" />
    </LinearLayout>

    <!-- Across Align: fixed for the camera, so only here - see Compositor.parallaxY. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <TextView
            android:id="@+id/fovShiftLabel"
            style="@style/Ff.Mono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="100dp"
            android:maxLines="1"
            android:letterSpacing="0.06"
            android:textColor="@color/ff_muted"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/fovShiftSeek"
            style="@style/Ff.Seek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:contentDescription="@string/shift_description"
            android:max="200" />
    </LinearLayout>

    <TextView
        style="@style/Ff.Note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="8dp"
        android:text="@string/fov_note" />
</LinearLayout>
